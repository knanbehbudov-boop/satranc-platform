# Sunucu ortam değişkenleri (packages/server/src/config.ts). Gizli değerleri koda yazmayın.
NODE_ENV=development
PORT=8080
HOST=127.0.0.1
DATABASE_URL=postgres://satranc:satranc-dev@127.0.0.1:54329/satranc
# Üretimde zorunlu, en az 32 karakter rastgele değer.
JWT_SECRET=
# Gerçek e-posta sağlayıcısı bağlanana kadar geliştirme posta kutusu (üretimde açılamaz).
DEV_MAILBOX=1
# Aynı IP/cihazdan aynı turnuvaya ikinci hesap engeli (üretimde varsayılan açık).
ANTI_MULTI_ACCOUNT=0
# K3: gecikme telafisi üst sınırı (ms).
LAG_COMP_CAP_MS=300
FIRST_MOVE_TIMEOUT_MS=60000
RECONNECT_TIMEOUT_MS=60000
# Stockfish ikili dosyası; boşsa yerleşik motor kullanılır.
STOCKFISH_PATH=
# Ters vekil (nginx, Cloudflare) arkasındaysa 1: istemci IP'si X-Forwarded-For'dan okunur.
TRUST_PROXY=0
LOG_LEVEL=info
# ---- M7 ödeme ----
# sandbox: yerleşik test sağlayıcısı (gerçek para yok; üretimde reddedilir). stripe: gerçek sağlayıcı.
PAYMENT_PROVIDER=sandbox
# Webhook imza anahtarı (Stripe panelindeki whsec_… değeri). Üretimde zorunlu.
PSP_WEBHOOK_SECRET=
# PAYMENT_PROVIDER=stripe için:
STRIPE_SECRET_KEY=
PUBLIC_BASE_URL=
# Sandbox webhook'larının gecikmesi (ms) ve yinelenme olasılığı (0–1): idempotency'yi sürekli sınar.
SANDBOX_DELIVERY_DELAY_MS=300
SANDBOX_DUPLICATE_RATE=0.2
# ---- Ücretli turnuva ----
# K6: ücretli turnuvaya giriş için insan rakiplere karşı minimum rated oyun.
PAID_MIN_RATED_GAMES=10
# Ödeme için koltuk rezervasyonu (sn).
SEAT_RESERVATION_SEC=600
# Yalnız geliştirme: ödül bekletmesini kısaltır (örn. 30). Üretimde reddedilir.
PRIZE_HOLD_SEC=
# ---- M4b analiz ve M10 adil oyun ----
# Sabit analiz derinliği (Stockfish: 18; yerleşik motor: 3) ve pozisyon başına süre sınırı.
ANALYSIS_DEPTH=
ANALYSIS_MOVETIME_MS=3000
ANALYSIS_WORKERS=1
# İlk N yarım hamle (açılış) istatistiğe girmez.
ANALYSIS_SKIP_PLIES=20
# Ücretsiz turnuva oyunlarını da analiz et (demo için 1).
ANALYZE_FREE_GAMES=0
# Orta riskte ödül bekletmesine eklenen süre (sn).
RISK_MEDIUM_EXTRA_HOLD_SEC=86400
