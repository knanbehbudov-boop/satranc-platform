# Sunucu ortam değişkenleri (packages/server/src/config.ts). Gizli değerleri koda yazmayın.
NODE_ENV=development
PORT=8080
HOST=127.0.0.1
DATABASE_URL=postgres://satranc:satranc-dev@127.0.0.1:54329/satranc
# Üretimde zorunlu, en az 32 karakter rastgele değer.
JWT_SECRET=
# Gerçek e-posta sağlayıcısı bağlanana kadar geliştirme posta kutusu (üretimde açılamaz).
DEV_MAILBOX=1
# Aynı IP/cihazdan aynı turnuvaya ikinci hesap engeli (üretimde varsayılan açık).
ANTI_MULTI_ACCOUNT=0
# K3: gecikme telafisi üst sınırı (ms).
LAG_COMP_CAP_MS=300
FIRST_MOVE_TIMEOUT_MS=60000
RECONNECT_TIMEOUT_MS=60000
# Stockfish ikili dosyası; boşsa yerleşik motor kullanılır.
STOCKFISH_PATH=
# Ters vekil (nginx, Cloudflare) arkasındaysa 1: istemci IP'si X-Forwarded-For'dan okunur.
TRUST_PROXY=0
LOG_LEVEL=info
